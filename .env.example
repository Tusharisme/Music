# Server-side AI for the copilot chat. Optional: visitors can also connect their own (free)
# key in the app. Set ONE key – the first one found is used – and it never reaches the browser.

# Google Gemini, free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq, free tier: https://console.groq.com/keys
# GROQ_API_KEY=
# OpenRouter, free models: https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# Anthropic Claude, paid: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=

# Optional: pick the provider explicitly (gemini | groq | openrouter | ollama | anthropic | custom)
# AI_PROVIDER=gemini
# Optional: model (defaults: gemini-flash-lite-latest, openai/gpt-oss-120b, openrouter/free, llama3.2, claude-opus-5-5)
# AI_MODEL=
# For ollama / custom: the OpenAI-compatible base URL, and a key if the service needs one
# AI_BASE_URL=http://localhost:11434/v1
# AI_API_KEY=

# Optional: AI requests per IP per 5 minutes (default 40)
# MIXMIND_RATE_LIMIT=40
# Optional: port for `npm start` (default 8787)
# PORT=8787
