# Server-side Claude access for the AI DJ copilot (never exposed to the browser).
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: override the default model used by the server (default: claude-opus-5-5)
# MIXMIND_AI_MODEL=claude-opus-5-5

# Optional: port for `npm start` (default 8787)
# PORT=8787
